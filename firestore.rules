rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/vault/config {
      allow get: if owns(uid);
      allow list: if false;
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['salt', 'iterations', 'encryptionVersion', 'verifier'])
        && request.resource.data.keys().hasAll(['salt', 'iterations', 'encryptionVersion', 'verifier'])
        && request.resource.data.salt is string
        && request.resource.data.iterations is int
        && request.resource.data.encryptionVersion == 1
        && request.resource.data.verifier is map
        && request.resource.data.verifier.keys().hasOnly(['ciphertext', 'iv', 'encryptionVersion'])
        && request.resource.data.verifier.ciphertext is string
        && request.resource.data.verifier.iv is string
        && request.resource.data.verifier.encryptionVersion == 1;
      allow update, delete: if false;
    }

    match /users/{uid}/records/{recordId} {
      allow get, list: if owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly(['ciphertext', 'iv', 'encryptionVersion', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['ciphertext', 'iv', 'encryptionVersion', 'createdAt', 'updatedAt'])
        && request.resource.data.ciphertext is string
        && request.resource.data.iv is string
        && request.resource.data.encryptionVersion == 1
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if owns(uid)
        && request.resource.data.keys().hasOnly(['ciphertext', 'iv', 'encryptionVersion', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['ciphertext', 'iv', 'encryptionVersion', 'createdAt', 'updatedAt'])
        && request.resource.data.ciphertext is string
        && request.resource.data.iv is string
        && request.resource.data.encryptionVersion == 1
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;
      allow delete: if owns(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
